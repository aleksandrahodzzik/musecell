# Copy to backend/.env and fill in. Never commit backend/.env.

# Meta Model API (https://api.meta.ai/v1)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
SCIENTIST_MODEL=muse-spark-1.3
MICROSCOPIST_MODEL=muse-spark-1.3
REVIEWER_MODEL=muse-wonder-1.0
SEGMENTER_MODEL=sam-3.1
# true = eval runs on public data may use muse-spark-1.3-contributor (Meta may train on prompts)
ALLOW_CONTRIBUTOR=false

# Default provider for the Scientist + Microscopist: meta | baseten
#   baseten = open weights, meta-models/muse-spark-open-1026 via https://inference.baseten.co/v1
#   (SCIENTIST_MODEL / MICROSCOPIST_MODEL are then ignored). The PI reviewer (REVIEWER_MODEL) and SAM always stay
#   on the Meta Model API, so MODEL_API_KEY is needed either way. With BASETEN_API_KEY set, the start screen also
#   offers a per-run switch. fireworks | together are not verified and are refused.
PROVIDER=meta
BASETEN_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=

# NCBI E-utilities etiquette: sent as email= with tool=musecell on every PubMed request
NCBI_EMAIL=

# Data lives outside the repo and outside OneDrive
DATA_DIR=~/musecell-data

# Segmenter per object type: classical | sam (Phase-2 bake-off picked classical, see docs/DECISIONS.md)
NUCLEI_SEGMENTER=classical
CELL_SEGMENTER=classical

# Cost caps in USD
RUN_COST_CAP_USD=1.00
DAILY_COST_CAP_USD=20.00

# Model calls: timeout per request (s) and retries on 429/5xx/network errors
MODEL_TIMEOUT_S=180
MODEL_MAX_RETRIES=4
